#!/bin/env bash

COMMIT_MSG=$(head -n 1 "$1")
REGEX="^(feat|refactor|fix|docs|chore)(\(.+\))?: .+$"
if [[ $COMMIT_MSG =~ $REGEX ]]; then
    exit 0
else
    echo "----------------------------------------------------------------------"
    echo "ОШИБКА: Текст коммита не соответствует стандарту Conventional Commits!"
    echo "----------------------------------------------------------------------"
    echo "СТРУКТУРА: тип(область изменений): описание"
    echo "Тип и описание в коммите указывать обязательно, область изменений - "
    echo "опционально"
    echo "Все коммиты должны быть на английском языке"
    echo ""
    echo "ДОПУСТИМЫЕ ТИПЫ:"
    echo "  feat     - Добавление нового функционала"
    echo "  fix      - Исправление ошибки"
    echo "  refactor - Изменение кода без изменения логики (чистка, оптимизация)"
    echo "  docs     - Обновление документации"
    echo "  chore    - Обновление зависимостей, сборки, конфигов"
    echo ""
    echo "ПРИМЕРЫ:"
    echo "  feat(player): add player class"
    echo "  fix(physics): fix flight time"
    echo "  refactor: minor changes in code logic"
    echo "----------------------------------------------------------------------"
    exit 1
fi
